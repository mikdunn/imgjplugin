<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mikdunn</groupId>
  <artifactId>imgjplugin-fft</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>ImageJ FFT Orientation Plugin</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>

    <!-- Pin versions for reproducible builds -->
    <imagej1.version>1.54k</imagej1.version>
    <jtransforms.version>3.1</jtransforms.version>
    <jlargearrays.version>1.5</jlargearrays.version>
    <commons-math3.version>3.5</commons-math3.version>
  </properties>

  <dependencies>
    <!-- ImageJ 1.x API (ij.*) -->
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>ij</artifactId>
      <version>${imagej1.version}</version>
      <!-- Provided by Fiji / ImageJ2 (legacy) at runtime; don't bundle into plugin jar -->
      <scope>provided</scope>
    </dependency>

    <!-- Fast FFT implementation -->
    <dependency>
      <groupId>com.github.wendykierp</groupId>
      <artifactId>JTransforms</artifactId>
      <version>${jtransforms.version}</version>
    </dependency>

    <!-- JTransforms runtime dependencies (declare explicitly so they get shaded) -->
    <dependency>
      <groupId>pl.edu.icm</groupId>
      <artifactId>JLargeArrays</artifactId>
      <version>${jlargearrays.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-math3</artifactId>
      <version>${commons-math3.version}</version>
    </dependency>

    <!-- Test (smoke test the math without launching ImageJ UI) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- This project uses a non-standard layout: sources live in FFT/src -->
    <sourceDirectory>src</sourceDirectory>

    <!-- Resources live in FFT/resources (e.g., plugins.config for Fiji) -->
    <resources>
      <resource>
        <directory>resources</directory>
        <filtering>false</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
          <!-- Only compile the ImageJ plugin classes used for FIBA orientation analysis -->
          <includes>
            <include>fftanalysis/imagej/FibaMatlabProcessor.java</include>
            <include>fftanalysis/imagej/FIBA_Orientation.java</include>
            <include>fftanalysis/imagej/FIBA_Orientation_Profile.java</include>
            <include>fftanalysis/imagej/FIBA_All_FromFolder.java</include>
            <include>fftanalysis/imagej/TileUtils.java</include>
            <include>fftanalysis/imagej/FIBA_Tile_ByContent.java</include>
            <include>fftanalysis/imagej/FIBA_Tile_Montage.java</include>
          </includes>

          <!-- Always compile tests -->
          <testIncludes>
            <testInclude>**/*Test.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>

      <!-- Create a plugin jar that includes JTransforms (but not ImageJ itself) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!-- Attach a single self-contained jar (excluding provided ImageJ) -->
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>shaded</shadedClassifierName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>